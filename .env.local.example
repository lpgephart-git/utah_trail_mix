# Copy this file to `.env.local` and fill in from your Supabase project
# (Supabase dashboard → Project Settings → API).
#
# Until these are set, the site runs in preview mode with seed data.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL used in auth email links (local dev default shown).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
